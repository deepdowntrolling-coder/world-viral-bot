name: World Viral Daily Bot

on:
  schedule:
    - cron: '0 5 * * *'   # 08:00 Helsinki = 05:00 UTC
    - cron: '0 15 * * *'  # 18:00 Helsinki = 15:00 UTC
  workflow_dispatch:
    inputs:
      pillar:
        description: 'Pillar (earth, tech, money)'
        required: true
        default: 'earth'
        type: choice
        options:
          - earth
          - tech
          - money

jobs:
  generate-and-upload:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install -r requirements.txt
      - name: Run bot
        env:
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          YOUTUBE_CLIENT_ID: ${{ secrets.YOUTUBE_CLIENT_ID }}
          YOUTUBE_CLIENT_SECRET: ${{ secrets.YOUTUBE_CLIENT_SECRET }}
          YOUTUBE_REFRESH_TOKEN: ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
        run: |
          python main.py --pillar ${{ github.event.inputs.pillar || 'auto' }}
      - uses: actions/upload-artifact@v4
        with:
          name: video-${{ github.run_number }}
          path: output/
